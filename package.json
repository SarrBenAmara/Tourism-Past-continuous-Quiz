{
  "name": "tourism-quiz-challenge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node rules-tests/simulate-rules.cjs",
    "test:unit": "vitest run",
    "test:rules-offline": "node rules-tests/simulate-rules.cjs",
    "lint": "oxlint src",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,database --project demo-tourism-quiz",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only database"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.3.0",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.90.0",
    "targaryen": "^3.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
