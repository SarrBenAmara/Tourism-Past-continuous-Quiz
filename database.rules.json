{
  "rules": {
    ".read": false,
    ".write": false,

    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "banks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('teachers').child(auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('teachers').child(auth.uid).val() === true"
      }
    },

    "hostRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('teachers').child(auth.uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('teachers').child(auth.uid).val() === true",
        "$code": { ".validate": "$code.matches(/^[0-9][0-9][0-9][0-9][0-9][0-9]$/) && newData.isNumber()" }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('meta/hostUid').val() === auth.uid",
        ".write": "auth != null && root.child('teachers').child(auth.uid).val() === true && ((data.exists() && data.child('meta/hostUid').val() === auth.uid) || (!data.exists() && newData.child('meta/hostUid').val() === auth.uid && newData.child('meta/createdAt').val() === now))",
        ".validate": "$code.matches(/^[0-9][0-9][0-9][0-9][0-9][0-9]$/) && newData.hasChildren(['meta', 'state'])",

        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['hostUid', 'createdAt', 'teamCount', 'timerSec']) && (!data.exists() || (newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          "teamCount": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4" },
          "timerSec": { ".validate": "newData.val() === 15 || newData.val() === 20 || newData.val() === 30 || newData.val() === 45 || newData.val() === 60" }
        },

        "state": {
          ".read": "auth != null",
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|teams|preview|question|paused|closed|reveal|leaderboard|ended)$/)" }
        },

        "hostOnline": { ".read": "auth != null", ".validate": "newData.isBoolean()" },
        "teamBoard": { ".read": "auth != null" },

        "names": {
          "$key": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('rooms').child($code).child('meta').exists() && now < root.child('rooms').child($code).child('meta/createdAt').val() + 43200000 && root.child('rooms').child($code).child('state/phase').val() !== 'ended' && (root.child('rooms').child($code).child('state/phase').val() === 'lobby' || root.child('rooms').child($code).child('meta/lateJoin').val() === true) && !root.child('rooms').child($code).child('banned').child(auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
            ".validate": "newData.isString() && $key.matches(/^[a-z0-9_]+$/) && $key.length <= 20"
          }
        },

        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta').exists() && now < root.child('rooms').child($code).child('meta/createdAt').val() + 43200000 && root.child('rooms').child($code).child('state/phase').val() !== 'ended' && (root.child('rooms').child($code).child('state/phase').val() === 'lobby' || root.child('rooms').child($code).child('meta/lateJoin').val() === true || root.child('rooms').child($code).child('players').child($uid).exists()) && !root.child('rooms').child($code).child('banned').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'nameKey', 'joinedAt']) && newData.child('nameKey').val() === newData.child('name').val().toLowerCase().replace(' ', '_').replace('-', '_').replace(\"'\", '') && root.child('rooms').child($code).child('names').child(newData.child('nameKey').val()).val() === $uid",
            "name": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9 '-]*$/) && newData.val().length <= 20" },
            "nameKey": { ".validate": "newData.isString()" },
            "joinedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child($uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        },

        "banned": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        },

        "teams": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[ABCD]$/)"
          }
        },

        "answers": {
          "$q": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms').child($code).child('teams').child($uid).exists() && root.child('rooms').child($code).child('state/phase').val() === 'question' && root.child('rooms').child($code).child('state/qKey').val() === $q && now <= root.child('rooms').child($code).child('state/openedAt').val() + root.child('rooms').child($code).child('state/durationMs').val() + 1000",
              ".validate": "newData.hasChildren(['c', 't'])",
              "c": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3)" },
              "t": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },

        "results": {
          "$q": {
            "$uid": { ".read": "auth != null && auth.uid === $uid" }
          }
        },

        "scores": {
          "$uid": { ".read": "auth != null && auth.uid === $uid" }
        }
      }
    }
  }
}
